
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vesselos/guest_schema.json",
  "title": "VesselOS guest manifest v1.0",
  "description": "Guest manifest for the Fincantieri SDV challenge. Null means an unspecified value, not zero.",
  "type": "object",

  "required": [
    "schema_version",
    "id",
    "name",
    "source",
    "capability",
    "criticality",
    "assembly",
    "placement",
    "resources",
    "operational_modes",
    "installation",
    "special_events",
    "policy_hints",
    "documented_unknowns",
    "notes"
  ],

  "properties": {
    "schema_version": {
      "const": "1.0"
    },

    "id": {
      "type": "string",
      "pattern": "^G[1-9][0-9]*$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "source": {
      "type": "object",
      "required": ["document", "guest_card", "assumptions_added"],
      "properties": {
        "document": {"type": "string"},
        "guest_card": {"type": "string"},
        "assumptions_added": {"type": "array"}
      }
    },

    "capability": {
      "type": "object",
      "required": ["description", "value_by_mission"],
      "properties": {
        "description": {"type": "string"},
        "value_by_mission": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      }
    },

    "criticality": {
      "type": "object",
      "required": ["safety_critical", "mission_criticality"],
      "properties": {
        "safety_critical": {"type": "boolean"},
        "mission_criticality": {"type": "string"}
      }
    },

    "assembly": {
      "type": "object",
      "required": [
        "atomic_for_admission_and_shedding",
        "components",
        "requires",
        "excludes"
      ],
      "properties": {
        "atomic_for_admission_and_shedding": {
          "type": "boolean"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "mass_kg",
              "footprint_m2"
            ],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "mass_kg": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "footprint_m2": {
                "type": ["number", "null"],
                "minimum": 0
              }
            }
          }
        },
        "requires": {"type": "array"},
        "excludes": {"type": "array"}
      }
    },

    "placement": {
      "type": "object",
      "required": ["configurations"],
      "properties": {
        "configurations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "preferred",
              "assignments",
              "requirements",
              "notes"
            ],
            "properties": {
              "id": {"type": "string"},
              "preferred": {"type": "boolean"},
              "assignments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "component_id",
                    "location",
                    "bay_fraction",
                    "area_m2"
                  ],
                  "properties": {
                    "component_id": {"type": "string"},
                    "location": {"type": "string"},
                    "bay_fraction": {
                      "type": ["number", "null"],
                      "minimum": 0,
                      "maximum": 1
                    },
                    "area_m2": {
                      "type": ["number", "null"],
                      "minimum": 0
                    }
                  }
                }
              },
              "requirements": {"type": "array"},
              "notes": {"type": ["string", "null"]}
            }
          }
        }
      }
    },

    "resources": {
      "type": "object",
      "required": [
        "power_modes",
        "cooling",
        "data_links",
        "compute",
        "response_time"
      ],
      "properties": {
        "power_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "power_kw",
              "max_duration_minutes",
              "interruptible",
              "capability_fraction",
              "notes"
            ],
            "properties": {
              "id": {"type": "string"},
              "power_kw": {
                "type": "object",
                "required": ["min", "nominal", "peak"],
                "properties": {
                  "min": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "nominal": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "peak": {
                    "type": ["number", "null"],
                    "minimum": 0
                  }
                }
              },
              "max_duration_minutes": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "interruptible": {
                "type": ["boolean", "null"]
              },
              "capability_fraction": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "notes": {
                "type": ["string", "null"]
              }
            }
          }
        },

        "cooling": {
          "type": "object",
          "required": [
            "type",
            "electrical_kw_to_heat_kw",
            "chilled_water_load_rule",
            "notes"
          ],
          "properties": {
            "type": {"type": "string"},
            "electrical_kw_to_heat_kw": {
              "type": "number",
              "minimum": 0
            },
            "chilled_water_load_rule": {
              "type": "string"
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        },

        "data_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "bandwidth_mbps",
              "disabled_in_emission_silence",
              "notes"
            ],
            "properties": {
              "type": {"type": "string"},
              "bandwidth_mbps": {
                "type": "object",
                "required": ["min", "nominal", "max"],
                "properties": {
                  "min": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "nominal": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "max": {
                    "type": ["number", "null"],
                    "minimum": 0
                  }
                }
              },
              "disabled_in_emission_silence": {
                "type": "boolean"
              },
              "notes": {
                "type": ["string", "null"]
              }
            }
          }
        },

        "compute": {
          "type": "object",
          "required": [
            "cpu_cores",
            "ram_gb",
            "accelerator_units",
            "storage_gb"
          ],
          "properties": {
            "cpu_cores": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "ram_gb": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "accelerator_units": {
              "type": ["number", "null"],
              "minimum": 0
            },
            "storage_gb": {
              "type": ["number", "null"],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },

        "response_time": {
          "type": "object",
          "required": ["max_processing_latency_ms"],
          "properties": {
            "max_processing_latency_ms": {
              "type": ["number", "null"],
              "minimum": 0
            }
          }
        }
      }
    },

    "operational_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "requirements",
          "conflicts",
          "notes"
        ],
        "properties": {
          "id": {"type": "string"},
          "power_mode_id": {
            "type": ["string", "null"]
          },
          "allowed_power_mode_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          },
          "requirements": {"type": "array"},
          "conflicts": {"type": "array"},
          "notes": {
            "type": ["string", "null"]
          }
        },
        "oneOf": [
          {"required": ["power_mode_id"]},
          {"required": ["allowed_power_mode_ids"]}
        ]
      }
    },

    "installation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_ids",
          "port_only",
          "crew_required",
          "duration_minutes",
          "at_sea_window",
          "notes"
        ],
        "properties": {
          "component_ids": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "port_only": {"type": "boolean"},
          "crew_required": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "duration_minutes": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "at_sea_window": {
            "type": ["string", "null"]
          },
          "operation": {
            "type": "string",
            "enum": [
              "install_assembly",
              "install_component",
              "swap_vehicle_only",
              "swap_component",
              "logical_reconfiguration"
            ]
          },
          "operation_target": {
            "type": "string"
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    },

    "special_events": {
      "type": "array"
    },
    "policy_hints": {
      "type": "array"
    },
    "documented_unknowns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "notes": {
      "type": "array"
    }
  },

  "additionalProperties": false
}